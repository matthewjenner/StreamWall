<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia app -> StreamWall.exe. Views and view models only; behavior lives in Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(StreamWallWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(StreamWallMinWindows)</SupportedOSPlatformVersion>
    <AssemblyName>StreamWall</AssemblyName>
    <RootNamespace>StreamWall.App</RootNamespace>
    <!-- Required: without the supported-OS list, Avalonia cannot host native web views (M1). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Explorer, taskbar pins, the installer's shortcut). Scripts/gen-icons.sh makes it. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamWall.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icons (title bars, taskbar, Alt+Tab). Assets/icon.png is only the 1024 master for regenerating. -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The license ships in the install folder. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Injected into every cell (and frame) at document creation; see Docs/TECHARCH.md. -->
    <EmbeddedResource Include="Web\Scripts\*.js" LogicalName="%(Filename)%(Extension)" />
    <!-- The demo site (demo mode), served through a WebView2 virtual host; never used for real streams. -->
    <None Include="Web\DemoSite\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- WebView2's WPF/WinForms references are dropped repo-wide in Directory.Build.targets. -->

  <ItemGroup>
    <ProjectReference Include="..\StreamWall.Core\StreamWall.Core.csproj" />
    <ProjectReference Include="..\StreamWall.Platform\StreamWall.Platform.csproj" />
  </ItemGroup>
</Project>
