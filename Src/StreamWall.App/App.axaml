<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamWall.App.App"
             RequestedThemeVariant="Dark">
    <!-- Dark-first (Docs/DESIGN.md). The palette and styles grow with the control panel in M3. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
