<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StreamWall.App.ViewModels"
        xmlns:v="using:StreamWall.App.Views"
        x:Class="StreamWall.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <!--
      The control panel. Tabs are buttons over stacked pages (not a TabControl) so the Browser's
      web view stays alive while another tab is shown.
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12,16,8">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="StreamWall" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version}" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Name="WallsTabButton" Classes="tab" Classes.selected="{Binding IsWallsTab}" Content="Walls"
                            Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:ControlPanelTab.Walls}" />
                    <Button Name="BrowserTabButton" Classes="tab" Classes.selected="{Binding IsBrowserTab}" Content="Browser"
                            Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:ControlPanelTab.Browser}" />
                    <Button Name="StreamsTabButton" Classes="tab" Classes.selected="{Binding IsStreamsTab}" Content="Streams"
                            Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:ControlPanelTab.Streams}" />
                    <Button Name="SettingsTabButton" Classes="tab" Classes.selected="{Binding IsSettingsTab}" Content="Settings"
                            Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:ControlPanelTab.Settings}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Name="UpdateBanner" Margin="16,0,16,8" Padding="12,6" CornerRadius="6"
                Background="#1F3B82F6" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Name="InstallUpdateButton" Content="Restart and install" Classes="accent"
                        Command="{Binding InstallUpdateCommand}" IsVisible="{Binding Banner.ShowInstall, FallbackValue=False}" />
                <TextBlock Text="{Binding Banner.Text}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Name="StatusText" Text="{Binding Status}" Margin="16,6,16,10" Opacity="0.7" />

        <Panel Margin="16,4,16,0">
            <!-- Walls -->
            <ScrollViewer IsVisible="{Binding IsWallsTab}">
                <StackPanel Spacing="16" DataContext="{Binding Walls}" x:DataType="vm:WallsPageViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Name="AddWallButton" Content="Add wall" Classes="accent" Command="{Binding AddWallCommand}" />
                        <Button Name="ReloadAllButton" Content="Reload all" Command="{Binding ReloadAllCommand}" />
                        <TextBlock Text="Master volume" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Slider Name="MasterVolumeSlider" Minimum="0" Maximum="100" Width="160" Value="{Binding MasterVolume}" />
                        <CheckBox Name="MasterMuteBox" Content="Mute all" IsChecked="{Binding MasterMuted}" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding HasNoWalls}" Opacity="0.7" TextWrapping="Wrap"
                               Text="No walls yet. Add one (up to three), then find a stream in the Browser tab and use Send to wall." />
                    <ItemsControl Name="WallList" ItemsSource="{Binding Walls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallRowViewModel">
                                <Border Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="#33808080" Margin="0,0,0,12">
                                    <DockPanel>
                                        <v:WallMapHost DockPanel.Dock="Right" Margin="20,0,0,0" Map="{Binding Map}" ClearCommand="{Binding ClearCellCommand}" />
                                        <StackPanel Spacing="10">
                                            <TextBox Name="WallNameBox" Width="240" HorizontalAlignment="Left"
                                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Grid" VerticalAlignment="Center" />
                                                <ComboBox Name="RowsBox" ItemsSource="{x:Static vm:WallsPageViewModel.GridSizes}" SelectedItem="{Binding Rows}" />
                                                <TextBlock Text="rows x" VerticalAlignment="Center" />
                                                <ComboBox Name="ColumnsBox" ItemsSource="{x:Static vm:WallsPageViewModel.GridSizes}" SelectedItem="{Binding Columns}" />
                                                <TextBlock Text="columns, on" VerticalAlignment="Center" />
                                                <ComboBox Name="MonitorBox" ItemsSource="{Binding Monitors}" SelectedIndex="{Binding Monitor}" MinWidth="200" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <ToggleSwitch Name="OpenSwitch" IsChecked="{Binding IsOpen}" OnContent="Open" OffContent="Closed" />
                                                <ToggleSwitch IsChecked="{Binding Fullscreen}" OnContent="Fullscreen" OffContent="Window" />
                                                <Button Name="RemoveWallButton" Content="Remove wall" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Browser -->
            <v:BrowserView Name="Browser" DataContext="{Binding Browser}"
                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsBrowserTab}" />

            <!-- Streams -->
            <ScrollViewer IsVisible="{Binding IsStreamsTab}">
                <StackPanel Spacing="12" DataContext="{Binding Streams}" x:DataType="vm:StreamsPageViewModel">
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Every page you send to a wall from the Browser tab is saved here. Addresses stay hidden unless you reveal them." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Name="PasteUrlBox" Width="440" PlaceholderText="Or paste a stream address (https://...)" Text="{Binding PasteUrl}" />
                        <Button Name="AddStreamButton" Content="Add" Command="{Binding AddCommand}" />
                    </StackPanel>
                    <TextBlock Name="PasteError" Foreground="OrangeRed" Text="{Binding PasteError}"
                               IsVisible="{Binding PasteError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock IsVisible="{Binding IsEmpty}" Opacity="0.7" Text="No streams yet." />
                    <ItemsControl Name="StreamList" ItemsSource="{Binding Streams}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StreamRowViewModel">
                                <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#33808080" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="240,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                        <TextBox Name="StreamLabelBox" Text="{Binding Label, UpdateSourceTrigger=LostFocus}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Name="StreamUrlText" Text="{Binding DisplayUrl}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Placement}" Opacity="0.65" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Name="RevealButton" Content="{Binding RevealText}" Command="{Binding ToggleRevealCommand}" />
                                            <Slider Minimum="0" Maximum="100" Width="110" Value="{Binding Volume}" />
                                            <CheckBox Content="Mute" IsChecked="{Binding Muted}" />
                                            <Button Name="SendStreamButton" Content="Send to wall" Command="{Binding SendCommand}" />
                                            <Button Name="RemoveStreamButton" Content="Remove" Command="{Binding RemoveCommand}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" PlaceholderText="Video selector (optional, advanced)"
                                                 Text="{Binding VideoSelector, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer IsVisible="{Binding IsSettingsTab}">
                <StackPanel Spacing="10" MaxWidth="780" HorizontalAlignment="Left" DataContext="{Binding Settings}" x:DataType="vm:SettingsPageViewModel">
                    <TextBlock Text="Signing in" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Sign in to the site in the Browser tab, as in any browser. Every cell shares that session. If it ever expires, sign in there again and the cells recover." />
                    <TextBlock Text="Stream labels" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="How streams are named on the walls, in the picker and in Streams. A label you type yourself is never replaced." />
                    <ComboBox Name="LabelModeBox" ItemsSource="{x:Static vm:SettingsPageViewModel.LabelModes}" SelectedItem="{Binding LabelMode}" MinWidth="320" />
                    <TextBlock Text="Open in Browser (wall cells)" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="What a cell's Open in Browser button does with the cell. Moved streams stay in your library." />
                    <ComboBox Name="OpenInBrowserBox" ItemsSource="{x:Static vm:SettingsPageViewModel.OpenInBrowserModes}" SelectedItem="{Binding OpenInBrowser}" MinWidth="320" />
                    <TextBlock Text="Browser" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <ToggleSwitch Name="RestoreTabsSwitch" IsChecked="{Binding RestoreTabs}"
                                  OnContent="Reopen all tabs on launch" OffContent="Start with one tab (the last page)" />
                    <ToggleSwitch Name="FocusNewTabsSwitch" IsChecked="{Binding FocusNewTabs}"
                                  OnContent="Tabs opened from links come to the front" OffContent="Tabs opened from links load in the background" />
                    <ToggleSwitch Name="RememberZoomSwitch" IsChecked="{Binding RememberZoom}"
                                  OnContent="Remember zoom per site" OffContent="Do not remember zoom" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Name="ForgetZoomButton" Content="Forget saved zoom levels" Command="{Binding ForgetZoomCommand}" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{Binding SavedZoomSites, StringFormat='{}{0} site(s) saved'}" />
                    </StackPanel>
                    <TextBlock Text="Volume for new streams (0-100)" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Streams you send to a wall start at this volume, so an unexpectedly loud one never blasts. Adjust each on its strip." />
                    <NumericUpDown Name="NewStreamVolumeBox" Value="{Binding NewStreamVolume}" Minimum="0" Maximum="100" Increment="1" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Text="Reload a cell whose video stalls for (seconds)" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <NumericUpDown Value="{Binding StallTimeoutSeconds}" Minimum="5" Maximum="600" Increment="5" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Text="Privacy" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Logs never contain addresses or names: sites appear as pseudonyms such as site-7f3a9c and streams as cell numbers. Resetting gives everything new pseudonyms." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Reset pseudonyms" Command="{Binding ResetPseudonymsCommand}" />
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
