#!/usr/bin/env sh
# StreamWall pre-commit hook: gitleaks scan of the staged changes, for secrets and for any
# URL whose host is not on the allowlist in .gitleaks.toml (the site must never be committed).
# Enable once per clone:  git config core.hooksPath .githooks
# (CI runs the same scan over the full history, so this is the early warning.)

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks not installed; skipping the scan (CI still runs it)."
  echo "  Install: winget install gitleaks"
  exit 0
fi

if ! gitleaks git --staged --redact --no-banner --config .gitleaks.toml; then
  echo ""
  echo "pre-commit stopped: gitleaks found a secret or a non-allowlisted URL in the staged changes."
  echo "Use a placeholder under example.invalid. For a legitimate build/docs host, add it to"
  echo "the non-placeholder-url allowlist in .gitleaks.toml."
  exit 1
fi
