<Project>
  <!--
    Single source of truth for the app version. Inherited by every csproj in the repo.
    Bump with Scripts/bump-version.sh. 0.0.0 is "nothing shippable yet": CI builds and tests it
    but the release workflow never releases it.
  -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <!--
      Stops the .NET SDK appending "+<git-commit-hash>" to AssemblyInformationalVersion, so the
      About box and the update check see a clean "1.2.3".
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Matt Jenner</Authors>
    <Product>StreamWall</Product>
  </PropertyGroup>

  <!-- Shared values for the Windows-specific projects; Core and Core.Tests ignore them. -->
  <PropertyGroup>
    <!-- 19041 = Windows 10 2004, the oldest supported build. -->
    <StreamWallWindowsTfm>net10.0-windows10.0.19041.0</StreamWallWindowsTfm>
    <StreamWallMinWindows>10.0.19041.0</StreamWallMinWindows>
  </PropertyGroup>
</Project>
